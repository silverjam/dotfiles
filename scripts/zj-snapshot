#!/usr/bin/env python3
"""Snapshot a running zellij session into a restorable layout.

Dumps the session layout and rewrites every `claude` and `codex` pane to resume
the exact session currently running in it:

  claude  pane -> pid via ZELLIJ_PANE_ID -> ~/.claude/sessions/<pid>.json
  codex   pane title ("<thread name> | <dir>") + cwd -> threads in
          ~/.codex/state_*.sqlite

Writes:

  ~/.local/share/zj-snapshots/<session>.kdl          latest layout
  ~/.local/share/zj-snapshots/restore-<session>.sh   restores it
  ~/.local/share/zj-snapshots/history/<session>-<ts>.kdl  (last 50 kept)

Usage: zj-snapshot [session-name]   (defaults to $ZELLIJ_SESSION_NAME, else "zj")
"""
import json
import os
import re
import shlex
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

SESSION = (sys.argv[1] if len(sys.argv) > 1
           else os.environ.get("ZELLIJ_SESSION_NAME") or "zj")
OUT = Path.home() / ".local/share/zj-snapshots"
HIST = OUT / "history"
KEEP = 50
CLAUDE_SESSIONS = Path.home() / ".claude/sessions"
# Args that pin a specific/forked session; replaced by --resume <current id>.
DROP_FLAGS = {"--continue", "-c", "--fork-session"}
DROP_WITH_VALUE = {"--resume", "-r", "--session-id"}
CODEX_HOME = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
# Subcommands that pick a session; replaced by `resume <current id>`.
CODEX_SESSION_SUBCOMMANDS = {"resume", "fork"}
CODEX_DROP_FLAGS = {"--last", "--all"}
# The TUI prefixes its title with a status glyph (spinner, etc.) while busy.
CODEX_TITLE_STATUS = re.compile(r'^[^\w\s]\s+')
TRUNCATION = "..."


def zj(*args):
    return subprocess.run(["zellij", "-s", SESSION, "action", *args],
                          check=True, capture_output=True, text=True).stdout


def pane_pids():
    """Map zellij pane id -> list of claude pids running in it."""
    out = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if Path(f"/proc/{pid}/comm").read_text().strip() != "claude":
                continue
            env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        except OSError:
            continue
        vals = dict(e.split(b"=", 1) for e in env if b"=" in e)
        if vals.get(b"ZELLIJ_SESSION_NAME", b"").decode() != SESSION:
            continue
        pane = vals.get(b"ZELLIJ_PANE_ID")
        if pane:
            out.setdefault(int(pane), []).append(int(pid))
    return out


def session_id(pid):
    try:
        return json.loads((CLAUDE_SESSIONS / f"{pid}.json").read_text())["sessionId"]
    except (OSError, KeyError, ValueError):
        return None


def strip_session_args(args):
    out, skip = [], False
    for i, a in enumerate(args):
        if skip:
            skip = False
            continue
        if a in DROP_FLAGS:
            continue
        if a in DROP_WITH_VALUE:
            # --resume may be bare (opens picker); only skip a following non-flag value
            nxt = args[i + 1] if i + 1 < len(args) else None
            skip = nxt is not None and not nxt.startswith("-")
            continue
        if a.split("=", 1)[0] in DROP_WITH_VALUE:
            continue
        out.append(a)
    return out


def claude_resume_args(args, sid):
    return strip_session_args(args) + ["--resume", sid]


def codex_state_db():
    def version(p):
        m = re.search(r'_(\d+)\.sqlite$', p.name)
        return int(m.group(1)) if m else -1
    dbs = sorted(CODEX_HOME.glob("state_*.sqlite"), key=version)
    return dbs[-1] if dbs else None


def codex_threads():
    """Map cwd -> [(thread id, name)] for named, unarchived threads, newest first."""
    db = codex_state_db()
    if not db:
        return {}
    try:
        with sqlite3.connect(f"file:{db}?mode=ro", uri=True) as conn:
            rows = conn.execute(
                "select id, cwd, name from threads"
                " where archived = 0 and name is not null"
                " order by updated_at desc").fetchall()
    except sqlite3.Error:
        return {}
    out = {}
    for tid, cwd, name in rows:
        out.setdefault(cwd, []).append((tid, name))
    return out


def codex_thread(title, cwd, threads, used):
    name = CODEX_TITLE_STATUS.sub("", title).rsplit(" | ", 1)[0]
    truncated = name.endswith(TRUNCATION)
    prefix = name.removesuffix(TRUNCATION)
    for tid, thread_name in threads.get(cwd, []):
        matches = thread_name == name or (truncated and thread_name.startswith(prefix))
        if matches and tid not in used:
            return tid


def codex_resume_args(args, tid):
    rest = [a for a in args if a not in CODEX_DROP_FLAGS]
    sub = next((i for i, a in enumerate(rest) if a in CODEX_SESSION_SUBCOMMANDS), None)
    if sub is not None:
        has_session_arg = sub + 1 < len(rest) and not rest[sub + 1].startswith("-")
        del rest[sub:sub + 1 + has_session_arg]
    return ["resume", *rest, tid]


def kdl_args(args):
    return " ".join(json.dumps(a) for a in args)


def main():
    layout = zj("dump-layout")
    panes = [p for p in json.loads(zj("list-panes", "-a", "-j"))
             if not p["is_plugin"]]
    pids = pane_pids()
    threads = codex_threads()
    root_cwd = re.search(r'^\s*cwd "([^"]*)"', layout, re.M)
    root_cwd = root_cwd.group(1) if root_cwd else str(Path.home())

    used, used_threads = set(), set()
    lines = layout.splitlines()
    result, report = [], []
    tab_pos = -1
    i = 0
    while i < len(lines):
        line = lines[i]
        if re.match(r'^\s*tab\b', line):
            tab_pos += 1
        m = re.match(r'^(\s*)pane command="(claude|codex)"(.*)\{\s*$', line)
        if not m:
            result.append(line)
            i += 1
            continue

        indent, agent, attrs = m.groups()
        # Collect this pane's body (args / start_suspended) up to its closing brace.
        body, j = [], i + 1
        while not re.match(rf'^{indent}\}}\s*$', lines[j]):
            body.append(lines[j])
            j += 1
        args = []
        for b in body:
            am = re.match(r'^\s*args (.*)$', b)
            if am:
                args = shlex.split(am.group(1))
        cwd_m = re.search(r'cwd="([^"]*)"', attrs)
        cwd = cwd_m.group(1) if cwd_m else ""
        abs_cwd = os.path.normpath(os.path.join(root_cwd, cwd))
        cmd = " ".join([agent, *args])

        def pick(pred):
            for p in panes:
                if p["id"] not in used and p["tab_position"] == tab_pos and pred(p):
                    return p
        p = (pick(lambda p: p.get("pane_cwd") == abs_cwd and p.get("pane_command") == cmd)
             or pick(lambda p: p.get("pane_cwd") == abs_cwd
                     and (p.get("pane_command") or "").startswith(agent)))
        sid = None
        if p:
            used.add(p["id"])
            if agent == "claude":
                for pid in pids.get(p["id"], []):
                    sid = session_id(pid) or sid
            else:
                sid = codex_thread(p["title"], abs_cwd, threads, used_threads)
                used_threads.add(sid)

        if agent == "claude":
            new_args = claude_resume_args(args, sid) if sid else strip_session_args(args)
            missing = "NO SESSION FOUND (fresh claude)"
        else:
            # Unmatched codex panes keep their args: `codex resume` reopens the picker.
            new_args = codex_resume_args(args, sid) if sid else args
            missing = f"NO THREAD FOUND ({cmd})"
        report.append(f"  tab {tab_pos} {agent} {abs_cwd}: {sid or missing}"
                      + (f"  [{p['title']}]" if p else ""))

        result.append(f"{indent}pane command=\"{agent}\"{attrs}{{")
        if new_args:
            result.append(f"{indent}    args {kdl_args(new_args)}")
        # Drop start_suspended so sessions come back running on restore.
        result.extend(b for b in body
                      if not re.match(r'^\s*(args|start_suspended)\b', b))
        result.append(lines[j])
        i = j + 1

    OUT.mkdir(parents=True, exist_ok=True)
    HIST.mkdir(exist_ok=True)
    text = "\n".join(result) + "\n"
    latest = OUT / f"{SESSION}.kdl"
    tmp = latest.with_suffix(".tmp")
    tmp.write_text(text)
    tmp.replace(latest)
    (HIST / f"{SESSION}-{time.strftime('%Y%m%d-%H%M%S')}.kdl").write_text(text)
    for old in sorted(HIST.glob(f"{SESSION}-*.kdl"))[:-KEEP]:
        old.unlink()

    restore = OUT / f"restore-{SESSION}.sh"
    restore.write_text(f"""#!/usr/bin/env bash
# Restore zellij session "{SESSION}" from snapshot (taken {time.strftime('%F %T')}).
# Usage: restore-{SESSION}.sh [layout.kdl]   (defaults to latest snapshot;
#        older ones are in {HIST})
set -euo pipefail
layout="${{1:-{latest}}}"
name="{SESSION}"
if zellij list-sessions -n 2>/dev/null | grep -q "^$name "; then
  echo "A zellij session named '$name' already exists (possibly a dead/resurrectable one)."
  echo "Delete it first:  zellij delete-session --force $name"
  echo "or restore under another name:  zellij -s $name-restored -n \\"$layout\\""
  exit 1
fi
exec zellij -s "$name" -n "$layout"
""")
    restore.chmod(0o755)

    print(f"Saved {latest}")
    print("\n".join(report))
    print(f"Restore with: {restore}")


if __name__ == "__main__":
    main()
